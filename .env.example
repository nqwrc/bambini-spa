# bambini-spa reads one environment variable, only at build time (scripts/check-data.mjs).
# It is not a secret; it never goes through Credential Manager.
#
# BAMBINI_MODE=mockup      (default) placeholders allowed, unverified data listed as warnings
# BAMBINI_MODE=production  the build stops if a contact channel in data/contacts.json is not verified
BAMBINI_MODE=mockup
